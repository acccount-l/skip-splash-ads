{
  "schemaVersion": 1,
  "packageName": "com.baidu.BaiduMap",
  "rules": [
    {
      "id": "baidumap_splash_probe",
      "enabled": true,
      "activityIds": [
        "com.baidu.baidumaps.WelcomeScreen",
        "com.baidu.baidumaps.WelcomeScreen.Alias0",
        "com.baidu.baidumaps.WelcomeScreen.Alias1",
        "com.baidu.baidumaps.WelcomeScreen.Alias2",
        "com.baidu.baidumaps.WelcomeScreen.Alias3",
        "com.baidu.baidumaps.WelcomeScreen.Alias4",
        "com.baidu.baidumaps.WelcomeScreen.Alias5",
        "com.baidu.baidumaps.MapsActivity"
      ],
      "match": {
        "textRegex": "(?i)^(点击)?\\s*(跳过|skip)(\\s*广告)?\\s*[|·]?\\s*\\d*\\s*[sS秒]?$",
        "texts": [
          "跳过",
          "Skip"
        ],
        "clickable": false,
        "allowedBounds": [
          0.5,
          0.0,
          1.0,
          0.4
        ]
      },
      "action": "CLICK",
      "constraints": {
        "withinMsAfterLaunch": 10000,
        "cooldownMs": 2000,
        "maxAttempts": 1,
        "dryRun": false
      }
    },
    {
      "id": "baidumap_splash_id_probe",
      "enabled": true,
      "activityIds": [
        "com.baidu.baidumaps.WelcomeScreen",
        "com.baidu.baidumaps.WelcomeScreen.Alias0",
        "com.baidu.baidumaps.WelcomeScreen.Alias1",
        "com.baidu.baidumaps.WelcomeScreen.Alias2",
        "com.baidu.baidumaps.WelcomeScreen.Alias3",
        "com.baidu.baidumaps.WelcomeScreen.Alias4",
        "com.baidu.baidumaps.WelcomeScreen.Alias5",
        "com.baidu.baidumaps.MapsActivity"
      ],
      "match": {
        "viewIdRegex": "(?i).*(skip|splash.*(close|skip)|ad.*(close|skip)).*",
        "clickable": false,
        "allowedBounds": [
          0.4,
          0.0,
          1.0,
          1.0
        ]
      },
      "action": "CLICK",
      "constraints": {
        "withinMsAfterLaunch": 10000,
        "cooldownMs": 2000,
        "maxAttempts": 1,
        "dryRun": true
      }
    },
    {
      "id": "baidumap_splash_desc_probe",
      "enabled": true,
      "activityIds": [
        "com.baidu.baidumaps.WelcomeScreen",
        "com.baidu.baidumaps.WelcomeScreen.Alias0",
        "com.baidu.baidumaps.WelcomeScreen.Alias1",
        "com.baidu.baidumaps.WelcomeScreen.Alias2",
        "com.baidu.baidumaps.WelcomeScreen.Alias3",
        "com.baidu.baidumaps.WelcomeScreen.Alias4",
        "com.baidu.baidumaps.WelcomeScreen.Alias5",
        "com.baidu.baidumaps.MapsActivity"
      ],
      "match": {
        "contentDescriptionRegex": "(?i)^(点击)?\\s*(跳过|skip|关闭广告|close)(\\s*广告)?\\s*[|·]?\\s*\\d*\\s*[sS秒]?$",
        "clickable": false,
        "allowedBounds": [
          0.4,
          0.0,
          1.0,
          1.0
        ]
      },
      "action": "CLICK",
      "constraints": {
        "withinMsAfterLaunch": 10000,
        "cooldownMs": 2000,
        "maxAttempts": 1,
        "dryRun": true
      }
    },
    {
      "id": "baidumap_splash_sdk_id_probe",
      "enabled": true,
      "activityIds": [
        "com.baidu.baidumaps.WelcomeScreen",
        "com.baidu.baidumaps.WelcomeScreen.Alias0",
        "com.baidu.baidumaps.WelcomeScreen.Alias1",
        "com.baidu.baidumaps.WelcomeScreen.Alias2",
        "com.baidu.baidumaps.WelcomeScreen.Alias3",
        "com.baidu.baidumaps.WelcomeScreen.Alias4",
        "com.baidu.baidumaps.WelcomeScreen.Alias5",
        "com.baidu.baidumaps.MapsActivity"
      ],
      "match": {
        "viewIdRegex": "(?i).*:id/(ksad_skip_view_(skip|area|timer)|ksad_skip_icon|ksad_splash_(circle_)?skip_(left|right)_view|nad_skip_view|sdm_myoffer_splash_skip(_area)?|ms_skipView|skip_btn|lv_skip_text_view)$",
        "clickable": false,
        "allowedBounds": [
          0.0,
          0.0,
          1.0,
          0.35
        ]
      },
      "action": "CLICK",
      "constraints": {
        "withinMsAfterLaunch": 10000,
        "cooldownMs": 2000,
        "maxAttempts": 1,
        "dryRun": false
      }
    }
  ]
}
