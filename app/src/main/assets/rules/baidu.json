{
  "schemaVersion": 1,
  "packageName": "com.baidu.searchbox",
  "rules": [
    {
      "id": "baidu_splash_probe",
      "enabled": true,
      "activityIds": [
        "com.baidu.searchbox.SplashActivity",
        "com.baidu.searchbox.MainActivity"
      ],
      "match": {
        "textRegex": "(?i)^(点击)?\\s*(\\d{1,2}\\s*[sS秒]?\\s*)?(跳过|skip)(\\s*(广告|ad))?\\s*[|·]?\\s*\\d{0,2}\\s*[sS秒]?$",
        "texts": [
          "跳过",
          "跳过广告",
          "Skip"
        ],
        "clickable": false,
        "allowedBounds": [
          0.55,
          0.0,
          1.0,
          1.0
        ]
      },
      "action": "CLICK",
      "tapByGesture": true,
      "constraints": {
        "withinMsAfterLaunch": 8000,
        "cooldownMs": 100,
        "maxAttempts": 6,
        "dryRun": false
      }
    }
  ]
}
