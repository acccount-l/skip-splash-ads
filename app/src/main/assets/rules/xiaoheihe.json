{
  "schemaVersion": 1,
  "packageName": "com.max.xiaoheihe",
  "rules": [
    {
      "id": "xiaoheihe_splash_probe",
      "enabled": true,
      "activityIds": [
        "com.max.xiaoheihe.SplashActivity",
        "com.max.xiaoheihe.RouterActivity"
      ],
      "match": {
        "textRegex": "(?i)^(点击)?\\s*(跳过|skip)(\\s*广告)?\\s*[|·]?\\s*\\d*\\s*[sS秒]?$",
        "texts": [
          "跳过",
          "Skip"
        ],
        "clickable": false,
        "allowedBounds": [
          0.55,
          0.0,
          1.0,
          1.0
        ]
      },
      "action": "CLICK",
      "constraints": {
        "withinMsAfterLaunch": 10000,
        "cooldownMs": 2000,
        "maxAttempts": 1,
        "dryRun": true
      }
    }
  ]
}
