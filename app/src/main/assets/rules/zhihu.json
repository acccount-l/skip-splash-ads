{
  "schemaVersion": 1,
  "packageName": "com.zhihu.android",
  "rules": [
    {
      "id": "zhihu_splash_probe",
      "enabled": true,
      "activityIds": [
        "com.zhihu.android.app.ui.activity.LauncherActivity",
        "com.zhihu.android.app.ui.activity.LaunchAdActivity",
        "com.zhihu.android.app.ui.activity.MainActivity"
      ],
      "match": {
        "textRegex": "^(跳过|Skip|skip)\\s*\\d+$",
        "className": "android.widget.TextView",
        "clickable": true,
        "allowedBounds": [
          0.65,
          0.0,
          1.0,
          0.25
        ]
      },
      "action": "CLICK",
      "constraints": {
        "withinMsAfterLaunch": 8000,
        "cooldownMs": 2000,
        "maxAttempts": 1,
        "dryRun": false
      }
    }
  ]
}
