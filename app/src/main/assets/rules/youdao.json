{
  "schemaVersion": 1,
  "packageName": "com.youdao.dict",
  "rules": [
    {
      "id": "youdao_dict_splash_probe",
      "enabled": true,
      "activityIds": [
        "com.youdao.dict.activity.DictSplashActivity",
        "com.youdao.dict.activity.DictHotBootSplashActivity"
      ],
      "match": {
        "textRegex": "(?i)^(点击)?\\s*(跳过|skip)(\\s*广告)?\\s*[|·]?\\s*\\d*\\s*[sS秒]?$",
        "texts": [
          "跳过",
          "Skip"
        ],
        "clickable": false,
        "allowedBounds": [
          0.5,
          0.0,
          1.0,
          0.2
        ]
      },
      "action": "CLICK",
      "constraints": {
        "withinMsAfterLaunch": 10000,
        "cooldownMs": 2000,
        "maxAttempts": 1,
        "dryRun": false
      }
    },
    {
      "id": "youdao_dict_splash_id_probe",
      "enabled": true,
      "activityIds": [
        "com.youdao.dict.activity.DictSplashActivity",
        "com.youdao.dict.activity.DictHotBootSplashActivity"
      ],
      "match": {
        "viewIdRegex": ".*skip_bottom_view",
        "clickable": false,
        "allowedBounds": [
          0.0,
          0.0,
          1.0,
          1.0
        ]
      },
      "action": "CLICK",
      "constraints": {
        "withinMsAfterLaunch": 10000,
        "cooldownMs": 2000,
        "maxAttempts": 1,
        "dryRun": true
      }
    }
  ]
}
