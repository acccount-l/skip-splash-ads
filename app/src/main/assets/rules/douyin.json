{
  "schemaVersion": 1,
  "packageName": "com.ss.android.ugc.aweme",
  "rules": [
    {
      "id": "douyin_splash_probe",
      "enabled": true,
      "activityIds": [
        "com.ss.android.ugc.aweme.splash.SplashActivity",
        "com.ss.android.ugc.aweme.main.MainActivity",
        "com.ss.android.ugc.aweme.app.RealSplashDeeplinkActivity"
      ],
      "match": {
        "textRegex": "^(跳过|Skip|skip)\\s*\\d*$",
        "texts": [
          "跳过",
          "Skip"
        ],
        "clickable": true,
        "allowedBounds": [
          0.55,
          0.0,
          1.0,
          1.0
        ]
      },
      "action": "CLICK",
      "constraints": {
        "withinMsAfterLaunch": 8000,
        "cooldownMs": 2000,
        "maxAttempts": 1,
        "dryRun": true
      }
    }
  ]
}
