{
  "schemaVersion": 1,
  "packageName": "com.taobao.idlefish",
  "rules": [
    {
      "id": "xianyu_splash_probe",
      "enabled": true,
      "activityIds": [
        "com.taobao.fleamarket.home.activity.InitActivity",
        "com.taobao.fleamarket.splashad.SplashAdDialog"
      ],
      "match": {
        "textRegex": "(?i)^(点击)?\\s*(跳过|skip)(\\s*广告)?\\s*[|·]?\\s*\\d*\\s*[sS秒]?$",
        "texts": [
          "跳过",
          "Skip"
        ],
        "clickable": false,
        "allowedBounds": [
          0.4,
          0.0,
          1.0,
          0.2
        ]
      },
      "action": "CLICK",
      "constraints": {
        "withinMsAfterLaunch": 10000,
        "cooldownMs": 2000,
        "maxAttempts": 1,
        "dryRun": false
      }
    },
    {
      "id": "xianyu_splash_id_probe",
      "enabled": true,
      "activityIds": [
        "com.taobao.fleamarket.home.activity.InitActivity",
        "com.taobao.fleamarket.splashad.SplashAdDialog"
      ],
      "match": {
        "viewIdRegex": "(?i).*(skip|splash.*(close|skip)|ad.*(close|skip)).*",
        "clickable": false,
        "allowedBounds": [
          0.0,
          0.0,
          1.0,
          1.0
        ]
      },
      "action": "CLICK",
      "constraints": {
        "withinMsAfterLaunch": 10000,
        "cooldownMs": 2000,
        "maxAttempts": 1,
        "dryRun": true
      }
    },
    {
      "id": "xianyu_splash_desc_probe",
      "enabled": true,
      "activityIds": [
        "com.taobao.fleamarket.home.activity.InitActivity",
        "com.taobao.fleamarket.splashad.SplashAdDialog"
      ],
      "match": {
        "contentDescriptionRegex": "(?i)^(点击)?\\s*(跳过|skip|关闭广告|close)(\\s*广告)?\\s*[|·]?\\s*\\d*\\s*[sS秒]?$",
        "clickable": false,
        "allowedBounds": [
          0.0,
          0.0,
          1.0,
          1.0
        ]
      },
      "action": "CLICK",
      "constraints": {
        "withinMsAfterLaunch": 10000,
        "cooldownMs": 2000,
        "maxAttempts": 1,
        "dryRun": true
      }
    }
  ]
}
